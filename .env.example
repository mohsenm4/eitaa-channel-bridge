# Eitaa Channel Bridge — sample environment file.
# Copy to .env and fill in real values, or set these variables in your
# shell / orchestrator. Real environment variables always override .env.
# Comments start with "#" and may not appear inside quoted values.

# ── source: which Eitaa channel to read ─────────────────────────────
EITAA_BRIDGE_SOURCE_CHANNEL=Merajyan
EITAA_BRIDGE_SOURCE_POLL_INTERVAL=10s
# On the FIRST run only, walk back up to this many older messages
# through Eitaa's ?before= pagination. 0 disables backfill.
EITAA_BRIDGE_SOURCE_BACKFILL_MAX=200

# ── publishing: classify and filter posts ───────────────────────────
# Categories is a comma-separated list of "hashtag|slug|label" triples.
# A post is published only if it matches one of these — OR if it falls
# back to PUBLISHING_DEFAULT_CATEGORY.
EITAA_BRIDGE_PUBLISHING_CATEGORIES="گزارش_تصویری|reports|گزارش‌ها,اطلاعیه|announcements|اطلاعیه‌ها,مناسبت|occasions|مناسبت‌ها,کمک_مالی|support|حمایت,خبر|news|اخبار,معرفی|about|معرفی,پاسخ|faq|سوالات متداول"

# Optional. Posts without a matching category land here. Leave empty
# to drop unmatched posts instead.
EITAA_BRIDGE_PUBLISHING_DEFAULT_CATEGORY="general|عمومی"

# Comma-separated list. A post carrying any of these hashtags is
# always dropped, regardless of category.
EITAA_BRIDGE_PUBLISHING_SKIP_HASHTAGS=خصوصی,نمایش_نده

# ── target: where to publish each new message ───────────────────────
# Supported types: file | html | wordpress
EITAA_BRIDGE_TARGET_TYPE=html

# target.type=html (the only one with a working implementation)
EITAA_BRIDGE_TARGET_HTML_OUTPUT_DIR=site
EITAA_BRIDGE_TARGET_HTML_SITE_TITLE=کانال موسسه معراج

# target.type=file
# EITAA_BRIDGE_TARGET_FILE_PATH=data/published.jsonl

# target.type=wordpress (NOT YET IMPLEMENTED — Publish will error)
# EITAA_BRIDGE_TARGET_WORDPRESS_URL=https://example.com
# EITAA_BRIDGE_TARGET_WORDPRESS_USERNAME=admin
# EITAA_BRIDGE_TARGET_WORDPRESS_APP_PASSWORD=
# EITAA_BRIDGE_TARGET_WORDPRESS_POST_TYPE=post
# EITAA_BRIDGE_TARGET_WORDPRESS_STATUS=draft

# ── storage: local bookkeeping ──────────────────────────────────────
EITAA_BRIDGE_STORAGE_SEEN_FILE=data/seen.json
EITAA_BRIDGE_STORAGE_ARCHIVE_FILE=data/messages.jsonl

# ── logging ─────────────────────────────────────────────────────────
# Optional. debug | info | warn | error. Default: info
# EITAA_BRIDGE_LOG_LEVEL=info

# ── docker-compose only ─────────────────────────────────────────────
# Host port the nginx "web" container listens on. Default: 8080
# WEB_PORT=8080
