# Eitaa Channel Bridge — sample environment file.
# Copy to .env and fill in real values, or set these in your shell /
# orchestrator. Real env vars always override .env. Comments start
# with "#" and may not appear inside quoted values.

# ── source: which Eitaa channel to read ─────────────────────────────
# Channel username on eitaa.com (no leading @).
EITAA_CHANNEL=tesssst

# How often to poll when nothing recent is being watched. Default: 6h.
POLL_COLD=6h

# Fast poll used while a tracked message is still inside EDIT_WINDOW,
# so author edits / deletions are caught quickly. Default: 10s.
POLL_HOT=10s

# After publishing a message, keep polling at POLL_HOT for this long
# so edits/deletes are mirrored fast. After that, drop back to
# POLL_COLD. NOTE: keep EDIT_WINDOW > POLL_COLD or hot mode will
# never activate (a fresh message will already be older than the
# window by the time the next cold poll picks it up). Default: 1h.
EDIT_WINDOW=1h

# On the FIRST run only, walk back up to this many older messages
# through Eitaa's ?before= pagination. 0 disables backfill.
BACKFILL=200

# Optional dead-man's-switch: if set, the bridge GETs this URL on
# start and every HEALTHCHECK_INTERVAL. An external service (e.g.
# healthchecks.io) alerts you when the pings stop. Empty disables.
HEALTHCHECK_URL=
# Keep this a few minutes below the Period configured at the
# monitoring service so a single delayed ping never trips a false
# alarm. Default: 12m.
HEALTHCHECK_INTERVAL=12m

# ── publishing: classify and filter posts ───────────────────────────
# Comma-separated "hashtag|slug|label" triples. Maps each Eitaa
# hashtag to a WP category (label = WP category name).
# A message is published ONLY if one of its hashtags matches an entry
# below. Anything else is dropped without producing a post.
CATEGORIES="قرض_الحسنه|qarz-al-hasaneh|واحد قرض الحسنه,حمایت_خدمت|hemayat-khedmat|حمایت و خدمت,توانمندسازی|tavanmandsazi|واحد توانمندسازی,نوجوانان|nojavanan|واحد نوجوانان,اخبار_اطلاعیه|akhbar-etelaiyeh|اخبار اطلاعیه"

# Hashtags whose messages should be queued in data/inbox.log for
# manual review instead of auto-publishing. Use this for content that
# lives in a hand-curated UI element (e.g. the homepage hadith
# slider) with no REST equivalent. Comma-separated, no leading '#'.
INBOX_HASHTAGS="حدیث"

# Drop duplicates caused by Eitaa's double-send glitch: a new message
# is treated as a duplicate when its text matches an already-
# published one whose timestamp is within this window. 0 disables.
DEDUPE_WINDOW=10s

# ── target: WordPress site to publish into ──────────────────────────
WP_URL=https://example.com
WP_USER=admin
# Application Password (Users → Profile → Application Passwords in
# WP admin). Treat as a secret; do NOT commit a real one.
WP_APP_PASSWORD=
# post (default) or any custom post type slug.
WP_POST_TYPE=post
# draft | publish | private | pending. Default: draft.
WP_STATUS=draft

# ── homepage auto-updates ───────────────────────────────────────────
# Both settings below are OPTIONAL. On startup the bridge asks WP which
# page is the static front page (Settings → Reading), then walks the
# poster slideshow on that page. Each slide whose image filename / slug
# contains a category slug is auto-mapped to that category. After each
# publish, that slide's link is rewritten to point at the new post URL
# — so every poster on the homepage always opens the most recent report
# in its unit. Requires the eitaa-bridge-helper plugin v1.5+.
#
# To make auto-discovery work, just name the poster images after the
# category slug, e.g. "hemayat-khedmat-poster.png".
#
# Override either setting below when discovery fails or when you want
# to force a different mapping.
# HOMEPAGE_PAGE_ID=
# POSTER_LINKS="حمایت_خدمت|av-XXXX,قرض_الحسنه|av-YYYY"

# ── storage: local bookkeeping ──────────────────────────────────────
SEEN_FILE=data/seen.json
ARCHIVE_FILE=data/messages.jsonl

# ── logging ─────────────────────────────────────────────────────────
# debug | info | warn | error. Default: info
# LOG_LEVEL=info
