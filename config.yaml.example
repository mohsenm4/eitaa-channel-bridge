# Sample configuration. Copy this file to config.yaml and adjust.
# config.yaml is gitignored and never committed.

# ── source: which Eitaa channel to read ─────────────────────────────
source:
  channel: Merajyan           # channel username, without the @
  poll_interval: 10s          # how often to check (e.g. 10s, 5m, 1h)
  backfill_max: 200           # on FIRST run only, walk back this many older
                              # messages via ?before= pagination. 0 disables.

# ── publishing: classify and filter posts ───────────────────────────
# A post is published only if it matches a category here OR falls back
# to default_category. A post that carries any skip_hashtag is always
# dropped, regardless of category. Hashtag entries accept the leading
# "#" optionally.
publishing:
  categories:
    - hashtag: گزارش_تصویری
      slug: reports
      label: گزارش‌ها
    - hashtag: اطلاعیه
      slug: announcements
      label: اطلاعیه‌ها
    - hashtag: مناسبت
      slug: occasions
      label: مناسبت‌ها
    - hashtag: کمک_مالی
      slug: support
      label: حمایت
    - hashtag: خبر
      slug: news
      label: اخبار
    - hashtag: معرفی
      slug: about
      label: معرفی
    - hashtag: پاسخ
      slug: faq
      label: سوالات متداول
  # Optional. Posts without any matching category land here. Omit
  # default_category to drop unmatched posts instead.
  default_category:
    slug: general
    label: عمومی
  skip_hashtags:
    - خصوصی
    - نمایش_نده

# ── target: where to publish each new message ───────────────────────
# Supported types:
#   file       — append routed messages as JSONL to file.path
#   html       — generate a static site under html.output_dir
#   wordpress  — post to a WordPress REST API (NOT YET IMPLEMENTED)
target:
  type: html
  html:
    output_dir: site
    site_title: "کانال موسسه معراج"

  # type: file
  # file:
  #   path: data/published.jsonl

  # type: wordpress
  # wordpress:
  #   url: https://example.com
  #   username: admin
  #   app_password: ""
  #   post_type: post
  #   status: draft

# ── storage: local bookkeeping ──────────────────────────────────────
storage:
  seen_file: data/seen.json          # IDs of messages already processed
  archive_file: data/messages.jsonl  # raw archive of every message seen
